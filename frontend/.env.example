# Google Sign-In (OAuth 2.0 Client ID from https://console.cloud.google.com/apis/credentials)
# Must be the SAME Client ID as the backend's GOOGLE_CLIENT_ID.
# Authorized JavaScript origin: http://localhost:5173 (add your production domain too).
VITE_GOOGLE_CLIENT_ID=

# Deployed backend origin — leave EMPTY for local dev (Vite's proxy handles /api).
# Set this in production when the frontend (e.g. Vercel) and backend (e.g. Railway)
# live on different domains. No trailing slash, no /api suffix.
# Example: VITE_API_URL=https://ainabi-api.up.railway.app
VITE_API_URL=
